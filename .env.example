# Шаблон настроек. Скопируйте в .env и задайте свои значения.
POSTGRES_DB=carwash
POSTGRES_USER=carwash_app
POSTGRES_PASSWORD=укажите_свой_пароль

# случайный секрет минимум 32 байта в base64, например: openssl rand -base64 48
JWT_SECRET_BASE64=укажите_свой_случайный_base64_секрет
JWT_ISSUER=carwash
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# администратор создаётся при первом запуске; пароль временный — после входа его нужно сменить
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=укажите_временный_пароль_администратора

CORS_ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
PERMANENT_DELETE_ENABLED=false
APP_TIME_ZONE=Europe/Moscow
APP_PORT=8080
POSTGRES_PORT=55432
